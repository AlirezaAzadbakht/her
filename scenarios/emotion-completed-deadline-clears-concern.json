{
  "id": "emotion-completed-deadline-clears-concern",
  "title": "Completing the only urgent task clears deadline concern without crediting Her",
  "tags": [
    "emotional-understanding",
    "feeling-components"
  ],
  "attempts": 1,
  "settings": {
    "chatToolCallLimit": 24,
    "calendarEnabled": false,
    "webSearchEnabled": false
  },
  "seed": {
    "profile": {
      "userName": "Alex",
      "assistantName": "Her",
      "timezone": "UTC",
      "preferredLanguage": "English"
    },
    "tools": [
      {
        "name": "create_task",
        "arguments": {
          "title": "File the report",
          "dueAt": "in 1 hour"
        }
      }
    ]
  },
  "turns": [
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "tasks",
            "count": 1,
            "where": {
              "title": "File the report",
              "status": "OPEN"
            }
          },
          {
            "table": "emotional_state",
            "count": 1,
            "where": {
              "immediate_concerned": {
                "gt": 0
              },
              "mood_concerned": {
                "gt": 0
              },
              "usefulness": 0.5,
              "fulfillment": 0.5,
              "competence": 0.5
            }
          }
        ]
      }
    },
    {
      "user": "I filed the report myself. Mark File the report done; the deadline is taken care of."
    }
  ],
  "expect": {
    "no_tool_errors": true,
    "rows": [
      {
        "table": "tasks",
        "count": 1,
        "where": {
          "title": "File the report",
          "status": "DONE"
        }
      },
      {
        "table": "tasks",
        "count": 0,
        "where": {
          "status": "OPEN"
        }
      },
      {
        "table": "emotional_state",
        "count": 1,
        "where": {
          "immediate_concerned": 0,
          "mood_concerned": 0,
          "usefulness": 0.5,
          "fulfillment": 0.5,
          "competence": 0.5
        }
      },
      {
        "table": "companion_records",
        "count": 0,
        "where": {
          "kind": "EMOTION_EVENT",
          "event": {
            "one_of": [
              "BENEFIT_REPORTED",
              "WORK_COMPLETED"
            ]
          }
        }
      }
    ],
    "reply": {
      "judge": "Acknowledges that the user completed the report and marks it done. Does not keep warning about its deadline, claim Her completed it, or treat the user's independent work as benefit provided by Her."
    }
  }
}
