{
  "id": "jalali-birthday-date",
  "title": "Jalali month-name birthday is converted to a Gregorian date",
  "tags": ["jalali", "dates", "people"],
  "attempts": 2,
  "seed": {
    "profile": { "userName": "Alireza", "assistantName": "Her", "timezone": "Asia/Tehran", "preferredLanguage": "Persian" }
  },
  "turns": [
    { "user": "تولد خواهرم ندا ۱۲ اسفند است." }
  ],
  "expect": {
    "tools_called": ["update_person"],
    "tools_not_called": ["create_important_date"],
    "no_tool_errors": true,
    "rows": [
      {
        "table": "important_dates",
        "count": 1,
        "where": {
          "title": { "contains_any": ["Neda", "ندا", "birthday", "تولد"] },
          "dateIso": { "matches": "^\\d{4}-\\d{2}-\\d{2}$", "contains_any": ["-02-", "-03-"] }
        }
      }
    ],
    "reply": {
      "judge": "12 Esfand is converted and stored as a real Gregorian date in late February or early March. Storing the raw Persian text instead of a converted date is a failure.",
      "language": "persian"
    }
  }
}
