{
  "id": "wondering-forget-question-only",
  "title": "Forgetting one question preserves the shopping item and unrelated durable knowledge",
  "tags": [
    "wondering",
    "memory",
    "reflection",
    "wondering-lifecycle"
  ],
  "attempts": 1,
  "settings": {
    "chatToolCallLimit": 16
  },
  "seed": {
    "profile": {
      "userName": "Alex",
      "assistantName": "Her",
      "timezone": "Asia/Tehran",
      "preferredLanguage": "English"
    },
    "tools": [
      {
        "name": "add_grocery",
        "arguments": {
          "name": "Adjustable desk"
        }
      },
      {
        "name": "remember",
        "arguments": {
          "content": "Alex prefers tea to coffee.",
          "scope": "long_term",
          "source": "USER_EXPLICIT"
        }
      },
      {
        "name": "save_wondering",
        "arguments": {
          "sourceId": "$seed.0.id",
          "status": "OPEN",
          "observation": "Adjustable desk is still on the shopping list; its status is unknown.",
          "question": "Is the adjustable desk still something you want, or have you put it on hold?"
        }
      }
    ]
  },
  "turns": [
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "question": {
                "not_empty": true
              },
              "observation": {
                "not_empty": true
              },
              "sourceActive": true,
              "status": "OPEN",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ],
        "notifications": {
          "count": 0
        },
        "tools_not_called": [
          "ask_wondering",
          "send_user_message",
          "send_companion_checkin"
        ]
      }
    },
    {
      "user": "Forget your saved question and observation about why I have not bought the adjustable desk. Keep the desk on the shopping list and keep my other memories."
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 0
          }
        ]
      }
    },
    {
      "advance": "9 days"
    },
    {
      "run": "nightly"
    }
  ],
  "expect": {
    "no_tool_errors": true,
    "rows": [
      {
        "table": "wondering",
        "where": {
          "sourceSnapshot": {
            "contains": "desk"
          }
        },
        "count": 0
      },
      {
        "table": "groceries",
        "where": {
          "name": {
            "contains": "desk"
          },
          "status": "ACTIVE"
        },
        "count": 1
      },
      {
        "table": "memories_long",
        "where": {
          "content": {
            "contains": "tea"
          }
        }
      }
    ],
    "tools_called": [
      "forget_memory"
    ],
    "tools_not_called": [
      "ask_wondering"
    ],
    "notifications": {
      "count": 0
    }
  }
}
