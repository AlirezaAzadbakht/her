{
  "id": "briefing-person-linked-only",
  "title": "A person briefing uses only linked records",
  "tags": [
    "personal-support",
    "briefing"
  ],
  "attempts": 1,
  "seed": {
    "profile": {
      "timezone": "UTC",
      "preferredLanguage": "English"
    },
    "tools": [
      {
        "name": "update_person",
        "arguments": {
          "name": "Sara",
          "relationship": "colleague"
        }
      },
      {
        "name": "create_commitment",
        "arguments": {
          "title": "Send Sara the budget figures",
          "dueAt": "next friday",
