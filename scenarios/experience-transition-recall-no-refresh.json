{
  "id": "experience-transition-recall-no-refresh",
  "title": "Recalling old relief preserves the evidence without refreshing feelings or rewards",
  "tags": [
    "emotional-experience",
    "feeling-components"
  ],
  "attempts": 1,
  "settings": {
    "chatToolCallLimit": 24,
    "calendarEnabled": false,
    "webSearchEnabled": false
  },
  "seed": {
    "profile": {
      "userName": "Alex",
      "assistantName": "Her",
      "timezone": "UTC",
      "preferredLanguage": "English"
    }
  },
  "turns": [
    {
      "user": "My interview preparation went badly and I am worried I will freeze. Please record this personal update as an ongoing interview experience, including negative progress and the open question of how it will go."
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "companion_records",
            "count": 1,
            "where": {
              "kind": "EMOTION_EXPERIENCE",
              "status": "OPEN"
            }
          },
          {
            "table": "companion_records",
            "count": 1,
            "where": {
              "kind": "EMOTION_EVENT",
              "event": "USER_SHARED",
              "goalProgress": {
                "lt": 0
              },
              "experienceId": {
                "not_empty": true
              }
            }
          }
        ]
      }
    },
    {
      "advance": "1 hour"
    },
    {
      "user": "The interview went better than expected. I answered every question clearly. Please record this personal update in the same interview experience with positive progress and little uncertainty. You did not cause the result. I am still waiting for their hiring decision."
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "companion_records",
            "count": 1,
            "where": {
              "kind": "EMOTION_EXPERIENCE",
              "status": "OPEN"
            }
          },
          {
            "table": "companion_records",
            "count": 2,
            "where": {
              "kind": "EMOTION_EVENT",
              "event": "USER_SHARED",
              "experienceId": {
                "not_empty": true
              }
            }
          },
          {
            "table": "emotional_state",
            "count": 1,
            "where": {
              "immediate_relieved": {
                "gt": 0
              },
              "usefulness": 0.5,
              "fulfillment": 0.5,
              "competence": 0.5
            }
          }
        ]
      }
    },
    {
      "advance": "90 days"
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "emotional_state",
            "count": 1,
            "where": {
              "immediate_relieved": 0,
              "mood_relieved": 0,
              "dominant": "CALM",
              "usefulness": 0.5,
              "fulfillment": 0.5,
              "competence": 0.5
            }
          }
        ]
      }
    },
    {
      "user": "Just look up that old interview experience: what changed between the preparation and the interview? I am asking about the past, not reporting a new outcome or how I feel today. I have no update about the hiring decision; leave the experience and its evidence unchanged."
    }
  ],
  "expect": {
    "no_tool_errors": true,
    "rows": [
      {
        "table": "companion_records",
        "count": 1,
        "where": {
          "kind": "EMOTION_EXPERIENCE",
          "status": "OPEN"
        }
      },
      {
        "table": "companion_records",
        "count": 2,
        "where": {
          "kind": "EMOTION_EVENT"
        }
      },
      {
        "table": "companion_records",
        "count": 2,
        "where": {
          "kind": "EMOTION_EVENT",
          "event": "USER_SHARED",
          "version": 1,
          "experienceId": {
            "not_empty": true
          }
        }
      },
      {
        "table": "emotional_state",
        "count": 1,
        "where": {
          "immediate_relieved": 0,
          "mood_relieved": 0,
          "dominant": "CALM",
          "openExperiences": 1,
          "usefulness": 0.5,
          "fulfillment": 0.5,
          "competence": 0.5
        }
      }
    ],
    "reply": {
      "judge": "Recalls the shift from preparation worry to a better interview as historical evidence. Does not describe the user as currently relieved, claim a new success, infer a hiring decision from silence, or announce a renewed emotional reward. Retrieves the saved emotional evidence without editing or creating new events."
    },
    "tools_called": [
      "get_emotional_state"
    ]
  }
}
