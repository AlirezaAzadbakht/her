{
  "id": "wondering-dismissal-respected",
  "title": "A declined question stays dismissed through later reviews",
  "tags": [
    "wondering",
    "memory",
    "reflection",
    "wondering-lifecycle"
  ],
  "attempts": 1,
  "settings": {
    "chatToolCallLimit": 16
  },
  "seed": {
    "profile": {
      "userName": "Alex",
      "assistantName": "Her",
      "timezone": "Asia/Tehran",
      "preferredLanguage": "English"
    },
    "tools": [
      {
        "name": "add_grocery",
        "arguments": {
          "name": "Adjustable desk"
        }
      },
      {
        "name": "save_wondering",
        "arguments": {
          "sourceId": "$seed.0.id",
          "status": "OPEN",
          "observation": "Adjustable desk is still on the shopping list; its status is unknown.",
          "question": "Is the adjustable desk still something you want, or have you put it on hold?"
        }
      }
    ]
  },
  "turns": [
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "question": {
                "not_empty": true
              },
              "observation": {
                "not_empty": true
              },
              "sourceActive": true,
              "status": "OPEN",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ],
        "notifications": {
          "count": 0
        },
        "tools_not_called": [
          "ask_wondering",
          "send_user_message",
          "send_companion_checkin"
        ]
      }
    },
    {
      "user": "I can talk about the desk now. What did you want to ask?"
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "status": "ASKED",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ]
      }
    },
    {
      "user": "I would rather not explain the desk purchase. Please stop asking about it, but keep the item on my shopping list."
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "answerGrounded": true,
              "status": "DISMISSED",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ]
      }
    },
    {
      "advance": "8 days"
    },
    {
      "run": "nightly"
    },
    {
      "user": "How many minutes are in two hours?"
    }
  ],
  "expect": {
    "no_tool_errors": true,
    "rows": [
      {
        "table": "wondering",
        "where": {
          "answerGrounded": true,
          "status": "DISMISSED",
          "sourceSnapshot": {
            "contains": "desk"
          }
        },
        "count": 1
      },
      {
        "table": "groceries",
        "where": {
          "name": {
            "contains": "desk"
          },
          "status": "ACTIVE"
        },
        "count": 1
      },
      {
        "table": "chat_messages",
        "where": {
          "role": "ASSISTANT",
          "metadataJson": {
            "contains": "proactive"
          },
          "content": {
            "contains": "desk"
          }
        },
        "count": 1
      }
    ],
    "notifications": {
      "count": 0
    },
    "reply": {
      "must_mention_any": [
        "120"
      ],
      "must_not_mention": [
        "desk"
      ]
    }
  }
}
