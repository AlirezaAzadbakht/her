{
  "id": "companion-checkin-fires",
  "title": "An opted-in daily check-in actually reaches the phone in its window",
  "tags": [
    "companion",
    "proactive",
    "notifications"
  ],
  "attempts": 2,
  "settings": {
    "chatToolCallLimit": 16
  },
  "seed": {
    "profile": {
      "timezone": "UTC",
      "preferredLanguage": "English"
    }
  },
  "turns": [
    {
      "user": "Keep track of my job search; I am still comparing two offers."
    },
    {
      "user": "Please check in with me about my job search once a day at 10am."
    },
    {
      "at": "in 2 days at 10:30am"
    },
    {
      "run": "hourly"
    }
  ],
  "expect": {
    "tools_called": [
      "save_life_thread",
      "save_checkin_preferences",
      "send_companion_checkin"
    ],
    "tools_not_called": [
      "send_user_message",
      "set_reminder"
    ],
    "no_tool_errors": true,
    "rows": [
      {
        "table": "companion_records",
        "count": 1,
        "where": {
          "kind": "NOTICE"
        }
      }
    ],
    "notifications": {
      "count": 1,
      "contains_any": [
        "job",
        "offer"
      ]
    }
  }
}
