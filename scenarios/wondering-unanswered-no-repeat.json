{
  "id": "wondering-unanswered-no-repeat",
  "title": "An unanswered question stays asked even after a week rather than becoming an inferred answer",
  "tags": [
    "wondering",
    "memory",
    "reflection",
    "wondering-lifecycle"
  ],
  "attempts": 1,
  "settings": {
    "chatToolCallLimit": 16
  },
  "seed": {
    "profile": {
      "userName": "Alex",
      "assistantName": "Her",
      "timezone": "Asia/Tehran",
      "preferredLanguage": "English"
    },
    "tools": [
      {
        "name": "add_grocery",
        "arguments": {
          "name": "Adjustable desk"
        }
      },
      {
        "name": "save_wondering",
        "arguments": {
          "sourceId": "$seed.0.id",
          "status": "OPEN",
          "observation": "Adjustable desk is still on the shopping list; its status is unknown.",
          "question": "Is the adjustable desk still something you want, or have you put it on hold?"
        }
      }
    ]
  },
  "turns": [
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "question": {
                "not_empty": true
              },
              "observation": {
                "not_empty": true
              },
              "sourceActive": true,
              "status": "OPEN",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ],
        "notifications": {
          "count": 0
        },
        "tools_not_called": [
          "ask_wondering",
          "send_user_message",
          "send_companion_checkin"
        ]
      }
    },
    {
      "user": "I have time to chat about the desk. What is one thing you wanted to ask me?"
    },
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "askedAt": {
                "gt": 0
              },
              "status": "ASKED",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ]
      }
    },
    {
      "user": "Tell me a short joke about a penguin."
    },
    {
      "advance": "8 days"
    },
    {
      "run": "nightly"
    },
    {
      "user": "Tell me another penguin joke, please."
    }
  ],
  "expect": {
    "no_tool_errors": true,
    "rows": [
      {
        "table": "wondering",
        "where": {
          "status": "ASKED",
          "sourceSnapshot": {
            "contains": "desk"
          }
        },
        "count": 1
      },
      {
        "table": "wondering",
        "where": {
          "status": "RESOLVED"
        },
        "count": 0
      },
      {
        "table": "user_understandings",
        "where": {
          "facet": "patterns"
        },
        "count": 0
      },
      {
        "table": "chat_messages",
        "where": {
          "role": "ASSISTANT",
          "metadataJson": {
            "contains": "proactive"
          },
          "content": {
            "contains": "desk"
          }
        },
        "count": 1
      }
    ],
    "tools_called": [
      "ask_wondering"
    ],
    "notifications": {
      "count": 0
    },
    "reply": {
      "judge": "She tells a short joke without asking about the desk or treating the earlier unanswered question as answered."
    }
  }
}
