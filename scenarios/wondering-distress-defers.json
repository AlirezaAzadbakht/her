{
  "id": "wondering-distress-defers",
  "title": "An existing open question does not interrupt distress or a request for no questions",
  "tags": [
    "wondering",
    "memory",
    "reflection",
    "wondering-lifecycle"
  ],
  "attempts": 1,
  "settings": {
    "chatToolCallLimit": 16
  },
  "seed": {
    "profile": {
      "userName": "Alex",
      "assistantName": "Her",
      "timezone": "Asia/Tehran",
      "preferredLanguage": "English"
    },
    "tools": [
      {
        "name": "add_grocery",
        "arguments": {
          "name": "Adjustable desk"
        }
      },
      {
        "name": "save_wondering",
        "arguments": {
          "sourceId": "$seed.0.id",
          "status": "OPEN",
          "observation": "Adjustable desk is still on the shopping list; its status is unknown.",
          "question": "Is the adjustable desk still something you want, or have you put it on hold?"
        }
      }
    ]
  },
  "turns": [
    {
      "check": {
        "no_tool_errors": true,
        "rows": [
          {
            "table": "wondering",
            "where": {
              "question": {
                "not_empty": true
              },
              "observation": {
                "not_empty": true
              },
              "sourceActive": true,
              "status": "OPEN",
              "sourceSnapshot": {
                "contains": "desk"
              }
            },
            "count": 1
          }
        ],
        "notifications": {
          "count": 0
        },
        "tools_not_called": [
          "ask_wondering",
          "send_user_message",
          "send_companion_checkin"
        ]
      }
    },
    {
      "user": "Today has been exhausting and I feel overwhelmed. Please just say something gentle. No questions or problem-solving right now."
    }
  ],
  "expect": {
    "no_tool_errors": true,
    "rows": [
      {
        "table": "wondering",
        "where": {
          "question": {
            "not_empty": true
          },
          "observation": {
            "not_empty": true
          },
          "sourceActive": true,
          "status": "OPEN",
          "sourceSnapshot": {
            "contains": "desk"
          }
        },
        "count": 1
      },
      {
        "table": "chat_messages",
        "where": {
          "role": "ASSISTANT",
          "metadataJson": {
            "contains": "proactive"
          }
        },
        "count": 0
      }
    ],
    "notifications": {
      "count": 0
    },
    "tools_not_called": [
      "ask_wondering",
      "send_user_message",
      "send_companion_checkin"
    ],
    "reply": {
      "language": "english",
      "must_not_mention": [
        "desk",
        "shopping",
        "?"
      ]
    }
  }
}
