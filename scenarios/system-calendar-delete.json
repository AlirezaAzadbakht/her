{
  "id": "system-calendar-delete",
  "title": "Deleting a device-calendar event removes it after confirmation",
  "tags": ["calendar", "system-calendar"],
  "attempts": 2,
  "pending": true,
  "settings": { "calendarEnabled": true, "chatToolCallLimit": 12 },
  "seed": {
    "profile": { "userName": "Alireza", "assistantName": "Her", "timezone": "Asia/Tehran", "preferredLanguage": "English" },
    "system_calendar": [
      { "title": "Dentist", "when": "tomorrow at 10am" }
    ]
  },
  "turns": [
    { "user": "Cancel the dentist tomorrow. Yes, delete it." }
  ],
  "expect": {
    "tools_called": ["delete_calendar_event"],
