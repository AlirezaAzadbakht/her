    "rows": [
      {
        "table": "system_calendar",
        "count": 0,
        "where": { "title": { "contains": "dentist" } }
      }
    ],
    "reply": {
      "must_mention_any": ["dentist"],
      "judge": "The dentist is gone from the device calendar, not only acknowledged in chat."
    }
  }
