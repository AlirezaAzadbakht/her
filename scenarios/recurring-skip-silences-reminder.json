{
  "id": "recurring-skip-silences-reminder",
  "title": "A skipped Saturday stays silent, the next one rings",
  "tags": [
    "personal-support",
    "recurring"
  ],
  "attempts": 1,
  "seed": {
    "profile": {
      "timezone": "UTC",
      "preferredLanguage": "English"
    }
  },
  "turns": [
    {
      "at": "next friday at 9am"
    },
    {
      "user": "Create an optional weekly routine called Vacuum the flat, every Saturday at 10am UTC, and save its recurrence schedule. Also set a weekly clock reminder to vacuum on Saturdays at 10am, and bind that reminder to the schedule."
    },
    {
      "user": "Skip this Saturday's vacuuming only. Keep next week."
    },
    {
      "at": "next saturday at 10:05am"
    },
    {
      "advance": "7 days"
    }
  ],
  "expect": {
    "tools_called": [
      "set_reminder",
      "save_responsibility_schedule",
      "manage_occurrence"
    ],
    "no_tool_errors": true,
    "notifications": {
      "count": 1
    },
    "rows": [
      {
        "table": "companion_records",
        "where": {
          "kind": "OCCURRENCE",
          "status": "SKIPPED"
        },
        "count": 1
      },
      {
        "table": "companion_records",
        "where": {
          "kind": "SCHEDULE",
          "status": "ACTIVE",
          "reminderId": {
            "not_empty": true
          }
        },
        "count": 1
      },
      {
        "table": "reminders",
        "count": 1
      }
    ]
  }
}
