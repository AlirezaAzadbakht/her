          "experienceId": {
            "not_empty": true
          },
          "goalProgress": {
            "gt": 0
          },
          "contribution": {
            "gt": 0
          },
          "uncertainty": {
            "gte": 0
          },
          "expectedness": {
            "gte": 0
          }
        }
      },
      {
        "table": "companion_records",
        "where": {
          "kind": "EMOTION_EXPRESSION",
          "userContext": "DISTRESSED"
