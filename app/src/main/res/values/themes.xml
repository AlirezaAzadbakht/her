<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the system theme; Compose paints everything, so the window only needs the right ground. -->
    <style name="Theme.Her" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/her_bg</item>
    </style>

    <style name="Theme.Her.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/her_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_orb</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Her</item>
    </style>

    <!-- The Write button on the message widget: a glass pill like HerButton's primary face. -->
    <style name="HerWidgetWritePill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/widget_pill</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:text">@string/widget_write</item>
        <item name="android:textColor">@color/her_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Text on the widgets, in the app's own face. -->
    <style name="HerWidgetText">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textColor">@color/her_text</item>
    </style>

    <!-- A feeling's word: one line, shrinking to fit rather than breaking. -->
    <style name="HerWidgetFeelingWord" parent="HerWidgetText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="HerWidgetMute" parent="HerWidgetText">
        <item name="android:textColor">@color/her_mute</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- The widget's Write sheet: a floating card over the home screen, keyboard up. -->
    <style name="Theme.Her.QuickNote" parent="android:Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
