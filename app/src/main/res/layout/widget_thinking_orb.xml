<?xml version="1.0" encoding="utf-8"?>
<!-- Her orb: a still frame at rest; while she replies, a loop of frames the flipper plays.
     95 ms a frame is WidgetOrb's loop (7.35 engine s / 3.24 speed / 24 frames) at the app's pace. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_orb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ViewFlipper
        android:id="@+id/widget_frames"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="95"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
