<?xml version="1.0" encoding="utf-8"?>
<!-- The app's ground: warm dark (or dawn) with a soft ambient glow and a faint glass edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/her_bg" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.5"
                android:centerY="0.4"
                android:endColor="@color/her_glow_clear"
                android:gradientRadius="80%"
                android:startColor="@color/her_glow"
                android:type="radial" />
            <stroke
                android:width="1dp"
                android:color="@color/her_stroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
